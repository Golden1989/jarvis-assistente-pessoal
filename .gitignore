# Python cache and virtual environments
__pycache__/
*.pyc
.venv/
venv/

# Local environment variables (in case you use .env later) - NEVER commit
.env
.env.*

# Personal context files - your information, never goes to the public repo
personality.txt
profile.txt
perfil.txt
people.txt
notes.txt
notes.txt.*.bak

# Google Calendar OAuth secrets - as sensitive as a password, NEVER commit
credentials.json
token.json

# Real app-launcher config (machine-specific install paths) - see app_whitelist.example.json
app_whitelist.json

# Local editor config (contains machine-specific paths)
.vscode/

# App log (rotating, written by web/app_log.py)
logs/

# Operating system
.DS_Store
Thumbs.db
